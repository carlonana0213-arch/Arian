# Local environment files (contains database credentials, API keys, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep the example file tracked to show the structure of your variables
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------
# Build & Compilation Outputs (If using TypeScript or Babel)
# ------------------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/